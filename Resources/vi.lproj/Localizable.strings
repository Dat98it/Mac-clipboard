"Copy something to start your history." = "Copy nội dung để bắt đầu lịch sử.";
"Saved locally. Click an item to paste." = "Đã lưu trên máy. Bấm một mục để dán.";
"Private or temporary clipboard content was skipped." = "Đã bỏ qua nội dung clipboard được đánh dấu riêng tư hoặc tạm thời.";
"This clipboard format cannot be saved. The clipboard was left unchanged." = "Định dạng clipboard này chưa được hỗ trợ. Clipboard vẫn giữ nguyên.";
"Copy exceeds the 8 MiB limit and was not saved. The clipboard was left unchanged." = "Nội dung copy vượt giới hạn 8 MiB nên không được lưu. Clipboard vẫn giữ nguyên.";
"History could not be saved. Recent items may be lost when you quit." = "Không lưu được lịch sử. Các mục mới có thể mất khi thoát app.";
"Saved history could not be read. Monitoring is paused. Clear All to reset, or resume to start a new history." = "Không đọc được lịch sử đã lưu. Đã tạm dừng theo dõi. Bấm Clear All để xóa hoặc Tiếp tục để tạo lịch sử mới.";
"History and system clipboard cleared." = "Đã xóa lịch sử và clipboard hệ thống.";
"Memory and clipboard cleared, but saved history could not be removed. Monitoring is paused. Retry Clear All before quitting." = "Đã xóa bộ nhớ và clipboard nhưng chưa xóa được lịch sử trên ổ đĩa. Đã tạm dừng theo dõi. Hãy bấm Clear All lần nữa trước khi thoát.";
"The item could not be copied to the clipboard. Nothing was pasted." = "Không chép được mục này vào clipboard. Chưa gửi lệnh dán.";
"Cmd+V sent to the previous app. If it did not paste, press Cmd+V there." = "Đã gửi Cmd+V tới ứng dụng trước đó. Nếu chưa được dán, hãy nhấn Cmd+V tại đó.";
"Copied to clipboard. Enable Accessibility for automatic paste, or switch back and press Cmd+V." = "Đã chép vào clipboard. Cấp quyền Trợ năng để tự động dán, hoặc quay lại ứng dụng và nhấn Cmd+V.";
"Copied to clipboard. Open the destination editor, then press Cmd+V." = "Đã chép vào clipboard. Mở ô nhập đích rồi nhấn Cmd+V.";
"Copied to clipboard. The previous input could not be focused safely. Switch back and press Cmd+V." = "Đã chép vào clipboard. Không xác nhận được focus ô nhập trước đó. Hãy quay lại ứng dụng và nhấn Cmd+V.";
"The clipboard changed before paste. Select the item again." = "Clipboard đã thay đổi trước khi dán. Hãy chọn lại mục cần dán.";
"Automatic paste cancelled. No paste command was sent." = "Đã hủy tự động dán. Chưa gửi lệnh dán.";
"Copied to clipboard. Automatic paste is unavailable. Switch back and press Cmd+V." = "Đã chép vào clipboard. Chưa thể tự động dán. Hãy quay lại ứng dụng và nhấn Cmd+V.";
"Test mode · isolated clipboard and storage" = "Chế độ thử · clipboard và dữ liệu riêng";
"Search text and links" = "Tìm văn bản và liên kết";
"Restore this item and paste into the previous app" = "Khôi phục mục này và dán vào ứng dụng trước đó";
"Your clipboard, kept on this Mac." = "Lịch sử clipboard, lưu ngay trên máy Mac.";
"Clear All" = "Clear All";
"Delete all saved history and clear the system clipboard" = "Xóa toàn bộ lịch sử đã lưu và clipboard hệ thống";
"Allow automatic paste" = "Cho phép tự động dán";
"Accessibility lets Mac ClipBoard return to your editor and send Cmd+V. Without it, items are copied and you can paste manually." = "Quyền Trợ năng giúp Mac ClipBoard quay lại ô nhập và gửi Cmd+V. Khi chưa có quyền, bạn vẫn có thể chọn mục rồi dán thủ công.";
"System Settings → Privacy & Security → Accessibility → + → Mac ClipBoard. Enable it, then return to your editor before opening history." = "Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Trợ năng → + → Mac ClipBoard. Bật quyền rồi quay lại ô nhập trước khi mở lịch sử.";
"Open Settings" = "Mở Cài đặt";
"Check Again" = "Kiểm tra lại";
"Your history starts here" = "Lịch sử của bạn bắt đầu tại đây";
"No matching items" = "Không có mục phù hợp";
"Copy text, an image or a file while Mac ClipBoard is running. New copies appear here, newest first." = "Copy văn bản, ảnh hoặc file khi Mac ClipBoard đang chạy. Nội dung mới nhất sẽ xuất hiện đầu danh sách.";
"Try a different search." = "Thử từ khóa khác.";
